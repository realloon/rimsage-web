---
import { toolItems } from '../../assets/site'
---

<section class="reveal" id="tools">
  <header>
    <h2 data-i18n="tools.title">Available Tools</h2>
  </header>

  <ul>
    {
      toolItems.map(tool => (
        <li>
          <span>{tool.name}</span>
          <span data-i18n={tool.descKey}>{tool.desc}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(256px, 1fr));
    gap: var(--space-2);
  }

  li {
    background-color: var(--card);
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  li > span {
    display: block;
    font-size: 14px;

    &:first-of-type {
      font-family: var(--monospace);
      color: var(--accent-3);
      margin-bottom: 8px;
    }

    &:last-of-type {
      color: var(--muted);
    }
  }
</style>
