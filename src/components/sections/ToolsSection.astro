---
const toolItems = [
  {
    name: 'search_source',
    descKey: 'tools.search',
    desc: 'Search RimWorld source code.',
  },
  {
    name: 'read_file',
    descKey: 'tools.read',
    desc: 'Read files with pagination.',
  },
  {
    name: 'list_directory',
    descKey: 'tools.list',
    desc: 'List directory contents.',
  },
  {
    name: 'get_def_details',
    descKey: 'tools.getDef',
    desc: 'Resolve Def details by defName.',
  },
  {
    name: 'search_defs',
    descKey: 'tools.searchDefs',
    desc: 'Search Def collections.',
  },
  {
    name: 'read_csharp_symbol',
    descKey: 'tools.readSymbol',
    desc: 'Read C# class/struct/interface definitions.',
  },
]
---

<section id="tools">
  <header>
    <h2>Available Tools</h2>
  </header>

  <ul>
    {
      toolItems.map(tool => (
        <li>
          <span>{tool.name}</span>
          <span data-i18n={tool.descKey}>{tool.desc}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(256px, 1fr));
    gap: var(--space-2);
  }

  li {
    background-color: var(--card);
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  li > span {
    display: block;
    font-size: 14px;

    &:first-of-type {
      font-family: var(--monospace);
      color: var(--accent-3);
      margin-bottom: 8px;
    }

    &:last-of-type {
      color: var(--muted);
    }
  }
</style>
