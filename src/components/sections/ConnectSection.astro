---
import CodeBlock from '../CodeBlock.astro'

type ConnectClient = {
  id: string
  label: string
  command: string
}

const connectClients: readonly ConnectClient[] = [
  {
    id: 'claude',
    label: 'Claude Code',
    command:
      '<span class="token-command">claude</span> mcp add rimsage --transport http https://mcp.rimsage.com/mcp',
  },
  {
    id: 'gemini',
    label: 'Gemini CLI',
    command:
      '<span class="token-command">gemini</span> mcp add rimsage --transport http https://mcp.rimsage.com/mcp',
  },
  {
    id: 'trae',
    label: 'TRAE',
    command: '# TODO: replace with TRAE MCP integration command',
  },
  {
    id: 'cursor',
    label: 'Cursor',
    command: '# TODO: replace with Cursor MCP integration command',
  },
  {
    id: 'kilo',
    label: 'Kilo Code',
    command: '# TODO: replace with Kilo Code MCP integration command',
  },
  {
    id: 'opencode',
    label: 'opencode',
    command: '<span class="token-command">opencode</span> mcp add',
  },
  {
    id: 'copilot',
    label: 'VS Code',
    command:
      '<span class="token-command">code</span> --add-mcp "{\\"name\\":\\"rimsage\\", \\"type\\": \\"http\\", \\"url\\": \\"https://mcp.rimsage.com/mcp\\"}"',
  },
]

const genericConfig = `<span class="token-punc">{</span>
  <span class="token-key">"mcpServers"</span><span class="token-punc">: {</span>
    <span class="token-key">"rimsage"</span><span class="token-punc">: {</span>
      <span class="token-key">"url"</span><span class="token-punc">: </span><span class="token-string">"https://mcp.rimsage.com/mcp"</span>
    <span class="token-punc">}</span>
  <span class="token-punc">}</span>
<span class="token-punc">}</span>`
---

<script>
  const tabs = document.querySelectorAll<HTMLElement>('.tabs > button')
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]')

  tabs.forEach(tab => {
    const { id } = tab.dataset

    tab.addEventListener('click', () => {
      tabs.forEach(tab => {
        if (tab.dataset.id === id) {
          tab.classList.add('active')
        } else {
          tab.classList.remove('active')
        }
      })

      panels.forEach(panel => {
        if (panel.dataset.id === id) {
          panel.style.display = 'unset'
        } else {
          panel.style.display = 'none'
        }
      })
    })
  })
</script>

<section id="connect">
  <header>
    <h2 data-i18n="connect.title">Connect in seconds</h2>
    <p data-i18n="connect.subtitle">
      Online service is the recommended default for new users.
    </p>
  </header>

  <article class="callout">
    <header>
      <h3 data-i18n="connect.onlineTitle">Online Service</h3>
      <p data-i18n="connect.onlineDesc">
        Use the hosted MCP endpoint to start instantly.
      </p>
    </header>

    <CodeBlock code="https://mcp.rimsage.com/mcp" />
  </article>

  <article class="commands">
    <header>
      <h3 data-i18n="connect.tabs.title">Integration Commands</h3>
      <p data-i18n="connect.tabs.subtitle">
        Pick your client. For placeholders, use the generic config below.
      </p>
    </header>

    <div class="tabs">
      {
        connectClients.map((client, index) => (
          <button class={index === 0 ? 'active' : ''} data-id={client.id}>
            {client.label}
          </button>
        ))
      }
    </div>

    {
      connectClients.map((client, index) => (
        <div
          data-panel
          data-id={client.id}
          style={`display: ${index === 0 ? 'unset' : 'none'};`}
        >
          <CodeBlock code={client.command} />
        </div>
      ))
    }

    <div class="generic">
      <h4 data-i18n="connect.genericTitle">Generic mcp.json</h4>
      <p data-i18n="connect.genericDesc">
        Works with most MCP-compatible clients.
      </p>
      <CodeBlock code={genericConfig} />
    </div>
  </article>
</section>

<style>
  .callout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    align-items: center;
    gap: 16px;

    background-color: var(--card);

    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
    margin-top: 16px;

    h3 {
      font-weight: bold;
      margin-bottom: 8px;
    }

    p {
      color: var(--muted);
    }
  }

  .commands {
    margin-top: 16px;

    header {
      h3 {
        font-weight: bold;
        margin-bottom: 8px;
      }

      p {
        color: var(--muted);
      }
    }
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block: 16px;

    button {
      font-size: 14px;
      color: var(--muted);
      background-color: var(--card);
      padding: var(--space-1) var(--space-2);
      border: 1px solid var(--line);
      border-radius: 999px;
      cursor: pointer;
      transition: 0.2s;

      &.active {
        color: var(--primary-ink);
        background-color: var(--primary);
      }
    }
  }

  .generic {
    margin-top: 16px;

    h4 {
      font-weight: bold;
      margin-bottom: 8px;
    }

    p {
      color: var(--muted);
      margin-bottom: 8px;
    }
  }
</style>
