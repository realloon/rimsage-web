---
import CodeBlock from '../CodeBlock.astro'
---

<section class="reveal" id="hero">
  <header>
    <p class="eyebrow">MCP Server for RimWorld Source</p>

    <h1>
      <span>RimSage</span>
      <span>RimWorld</span>
      <span data-i18n="hero.title3">Source MCP Server</span>
    </h1>

    <p class="subtitle" data-i18n="hero.subtitle">
      Give AI the ability to search and read RimWorld source.
    </p>

    <div>
      <a class="btn primary" href="#connect" data-i18n="hero.cta">Get Started</a
      >
      <a class="btn ghost" href="#tools" data-i18n="hero.ctaSecondary"
        >Explore Tools</a
      >
    </div>
  </header>

  <aside>
    <p data-i18n="hero.panelLabel">Online Endpoint</p>
    <CodeBlock code="https://mcp.rimsage.com/mcp" />
  </aside>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-3);
  }

  .eyebrow {
    color: var(--muted);
    font-weight: bold;
    text-transform: uppercase;
  }

  h1 {
    margin-block: 1rem;

    span {
      display: block;

      font-size: clamp(24px, 2.6vw, 40px);
      font-weight: normal;
      color: light-dark(#1f2a3a, #d5deea);

      &:first-of-type {
        font-size: clamp(32px, 4vw, 56px);
        font-weight: bold;
      }
    }
  }

  .subtitle {
    color: var(--muted);
    margin-bottom: 1rem;
  }

  aside {
    background: var(--card);
    border-radius: var(--radius);
    padding: var(--space-2);
    border: 2px solid var(--line);
    box-shadow: var(--shadow);

    p {
      font-size: 12px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: var(--space-1);
    }
  }
</style>
