---
import CopyButton from './CopyButton.astro'

interface Props {
  code: string
}

const { code } = Astro.props
---

<div class="code-block">
  <CopyButton />
  <pre><code set:html={code} /></pre>
</div>

<style>
  .code-block {
    position: relative;

    color: var(--code-ink);
    background-color: var(--code-bg);

    font-size: 14px;
    overflow-x: auto;

    padding: 12px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  pre {
    line-height: 1.5;
    white-space: pre;
    margin: 0;
  }
</style>
